{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/delivery-admin/:path*",
      "has": [
        {
          "type": "host",
          "value": "apurba-roy-three.vercel.app"
        }
      ],
      "destination": "https://apurba-roy-git-codex-admin-menu-sections-ramyachobi.vercel.app/delivery-admin/:path*",
      "permanent": false
    }
  ]
}
